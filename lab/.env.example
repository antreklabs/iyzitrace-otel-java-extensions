WILDFLY_VERSION=27.0.1.Final
OTEL_JAVA_AGENT_VERSION=2.21.0
OTEL_COLLECTOR_VERSION=0.159.0

# WildFly's server-wide service.name (one per JVM; the Tomcats use tomcat-10-lab / tomcat-9-lab).
OTEL_SERVICE_NAME=wildfly-27-lab
# Set to false to see the original problem (no deployment attributes), on all three servers.
DEPLOYMENT_EXTENSION_ENABLED=true

# Agent -> collector by default. To export straight to iyzitrace instead (like production):
#   AGENT_OTLP_ENDPOINT=http://host.docker.internal:80/ingest/otlp
#   AGENT_OTLP_HEADERS=iyzitrace-api-key=<key>
AGENT_OTLP_ENDPOINT=http://otel-collector:4318
AGENT_OTLP_HEADERS=

# Collector -> iyzitrace.
IYZITRACE_OTLP_ENDPOINT=http://host.docker.internal:80/ingest/otlp
IYZITRACE_API_KEY=replace-with-api-key

# Host ports (8080 is often taken).
WILDFLY_HTTP_PORT=8090
WILDFLY_MANAGEMENT_PORT=9990
TOMCAT10_HTTP_PORT=8091
TOMCAT9_HTTP_PORT=8092
JAEGER_UI_PORT=16686
LOADGEN_INTERVAL_SECONDS=2
